<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Comments_Required_On_Revert</fullName>
    <active>true</active>
    <description>Requires a comment when a Completed scan is reverted to In Progress</description>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c, &apos;In Progress&apos;),
    ISPICKVAL(PRIORVALUE(Status__c), &apos;Completed&apos;),
    ISBLANK(Comments__c)
)</errorConditionFormula>
    <errorDisplayField>Comments__c</errorDisplayField>
    <errorMessage>A revert reason is required when reopening a completed scan.</errorMessage>
</ValidationRule>
